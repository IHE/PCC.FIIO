@startuml
skinparam svgDimensionStyle false
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
hide footbox

box "Primary Data Holder" #EEF4FA
participant "Data Not\nAvailable to Portal" as nap
participant "Available\nPatient Data" as apd
participant "Provider Portal\n(Content Creator)" as ptp
end box
participant "Treating Clinic\n(Content Consumer)" as cc2

apd -> ptp : Conditions
apd -> ptp : Allergies
apd -> ptp : Medications
apd -> ptp : Immunizations
apd -> ptp : Care Plans
apd -> ptp : Alerts
apd -> ptp : Clinical Impressions
nap -->x ptp : Procedure Data
nap -->x ptp : Lab Data
nap -->x ptp : Device Data

note over ptp, cc2 : Results, Procedures, and\nMedical Devices sections\nare generated with an\nemptyReason of unavailable
ptp <-> cc2 : Document Sharing [PCC-1]\nIPS Document
@enduml
