@startuml
skinparam svgDimensionStyle false
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
hide footbox

actor "Patient" as pt
box "Primary Data Holder" #EEF4FA
participant "Data Not\nAvailable to Portal" as nap
participant "Available\nPatient Data" as apd
participant "Patient Portal\n(Content Creator)" as portal
end box
participant "Healthcare Provider\n(Content Consumer)" as cc2

pt -> portal : Request IPS
apd -> portal : Conditions
apd -> portal : Allergies
apd -> portal : Medications
apd -> portal : Immunizations
apd -> portal : Care Plans
apd -> portal : Alerts
apd -> portal : Procedure Data
apd -> portal : Device Data
nap -->x portal : Lab Data
portal -> pt : Draft IPS for review
pt -> portal : Flag preeclampsia\nand birth plan
pt -> portal : Add over-the-counter\nmedications
pt -> portal : Add Patient Story\n(missing immunization,\npregnancy concerns)
pt -> portal : Mask mental health\ncondition
portal -> portal : Generate final IPS
portal <-> cc2 : Document Sharing [PCC-1]\nIPS Document
@enduml
