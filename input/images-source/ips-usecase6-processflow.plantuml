@startuml
skinparam svgDimensionStyle false
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
hide footbox

box "Health Data Source" #EEF4FA
participant "Primary Care Data Source\n(Content Creator)" as pcds
end box
box "De-Identification" #EEF4FA
participant "Pseudonymization Service\n(Content Consumer,\nContent Creator)" as pns
participant "Anonymization Service\n(Content Consumer,\nContent Creator)" as ans
end box
box "Secondary Use" #EEF4FA
participant "Secondary Use Researcher\n(Content Consumer)" as sur
end box

note over pcds, pns : Primary data source provides\na fully identified\npatient summary document
pcds <-> pns : Document Sharing [PCC-1]\nIPS Document
pns -> pns : Stage 1\nDe-Identification
note over pns, ans : Provides a pseudonymized\ndata set formatted as an\nIPS document (Stage 1)
pns <-> ans : Document Sharing [PCC-1]\nIPS Document
ans -> ans : Stage 2\nDe-Identification
note over ans, sur : Provides a fully de-identified\ndata set formatted as an\nIPS document (Stage 2)
ans <-> sur : Document Sharing [PCC-1]\nIPS Document
@enduml
